[Unit]
Description=WhoUpdate Telegram priority webhook worker
Requires=who-update-postgresql.service
After=network.target who-update-postgresql.service maksonchik-web.service
Wants=maksonchik-web.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
EnvironmentFile=-/srv/maksonchik/database.env
ExecStart=/srv/maksonchik/venv/bin/python manage.py process_telegram_updates --queue priority
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
