[Unit]
Description=WhoUpdate daily CPU, RAM and disk report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
ExecStart=/srv/maksonchik/venv/bin/python manage.py check_resources --report
