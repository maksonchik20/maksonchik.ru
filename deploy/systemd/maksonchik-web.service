[Unit]
Description=maksonchik.ru Gunicorn
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
ExecStart=/srv/maksonchik/venv/bin/gunicorn --no-control-socket --access-logfile - --workers 2 --bind 127.0.0.1:8010 maksonchik.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
