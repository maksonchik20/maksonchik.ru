[Unit]
Description=WhoUpdate Telegram bot (long polling)
After=network.target maksonchik-web.service
Wants=maksonchik-web.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
ExecStart=/srv/maksonchik/venv/bin/python manage.py who_update_telegram_poll
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
