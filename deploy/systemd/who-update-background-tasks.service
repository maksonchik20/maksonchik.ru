[Unit]
Description=WhoUpdate reliable SQLite background task worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
ExecStart=/srv/maksonchik/venv/bin/python manage.py process_background_tasks --poll-interval 1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
