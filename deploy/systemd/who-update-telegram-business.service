[Unit]
Description=WhoUpdate Telegram business webhook worker
After=network.target maksonchik-web.service
Wants=maksonchik-web.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
ExecStart=/srv/maksonchik/venv/bin/python manage.py process_telegram_updates --queue business
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
