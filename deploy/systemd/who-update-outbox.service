[Unit]
Description=WhoUpdate reliable Telegram outbox sender
Requires=who-update-postgresql.service
After=network.target who-update-postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
EnvironmentFile=-/srv/maksonchik/database.env
ExecStart=/srv/maksonchik/venv/bin/python manage.py process_tg_outbox --limit 100 --loop --poll-interval 2
Restart=always
RestartSec=2
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
