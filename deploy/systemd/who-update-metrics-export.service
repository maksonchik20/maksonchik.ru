[Unit]
Description=Export WhoUpdate operational metrics to Yandex Monitoring
Requires=who-update-postgresql.service
After=network-online.target who-update-postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/maksonchik/app
Environment=DJANGO_SETTINGS_MODULE=maksonchik.settings
Environment=MPLCONFIGDIR=/srv/maksonchik/.cache/matplotlib
EnvironmentFile=-/srv/maksonchik/database.env
ExecStart=/srv/maksonchik/venv/bin/python manage.py export_operational_metrics --limit 500
